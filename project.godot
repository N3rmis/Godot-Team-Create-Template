; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Team Create Project Template"
config/description="Starter project template for Godot 4 with Team Create real-time collaborative editing pre-installed and enabled."
config/tags=PackedStringArray("template", "multiplayer", "tool", "collaboration")
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/team_create/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
